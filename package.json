{
  "name": "aruma-market",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @aruma/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aruma/db generate",
    "db:migrate": "pnpm --filter @aruma/db migrate",
    "db:seed": "pnpm --filter @aruma/db seed"
  }
}
