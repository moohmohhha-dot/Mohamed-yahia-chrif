{
  "name": "aruma-market",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aruma/core dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aruma/db generate",
    "db:migrate": "pnpm --filter @aruma/db migrate",
    "db:seed": "pnpm --filter @aruma/db seed",
    "dev:merchant": "pnpm --filter @aruma/merchant-center dev",
    "e2e:merchant": "pnpm --filter @aruma/merchant-center e2e",
    "dev:payments": "pnpm --filter @aruma/payments dev",
    "db:migrate:payments": "pnpm --filter @aruma/payments migrate",
    "dev:admin": "pnpm --filter @aruma/admin dev",
    "e2e:admin": "pnpm --filter @aruma/admin e2e",
    "security:test": "pnpm --filter @aruma/core exec vitest run test/security.test.ts",
    "security:audit": "pnpm audit --prod --audit-level moderate",
    "backup": "scripts/backup.sh",
    "backup:verify": "scripts/verify-backup.sh"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
