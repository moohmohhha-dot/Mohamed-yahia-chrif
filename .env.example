# PostgreSQL connection used by the API and migrations
DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma
# Separate database used by automated tests (it is wiped on every test run)
TEST_DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma_test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
# Max login/register attempts per IP per minute
AUTH_RATE_LIMIT_MAX=10
# 32 random bytes, base64 — generate with: openssl rand -base64 32
# Encrypts ID numbers, account numbers and documents. Keep it secret and backed up: losing it loses that data.
DATA_ENCRYPTION_KEY=
# After a key rotation only: the previous key(s), comma-separated, until scripts re-seal everything (docs/SECURITY.md)
DATA_ENCRYPTION_KEYS_OLD=
# ARUMA staff must use two-step verification (cannot be false in production)
STAFF_MFA_REQUIRED=true
# Requests per IP per minute on every route
GLOBAL_RATE_LIMIT_MAX=600
# true when the API is served over HTTPS (required in production)
HSTS=false
# Where uploaded documents are stored (encrypted)
STORAGE_DIR=./storage
NODE_ENV=development

# --- Payment Service (apps/payments) and its link with ARUMA CORE --------------------------------
# Generate each secret with: openssl rand -hex 32   (the same value goes to both services)
PAYMENTS_URL=http://localhost:3200
PAYMENTS_SERVICE_TOKEN=
PAYMENTS_EVENTS_SECRET=
STOREFRONT_URL=http://localhost:5174
# Development only: fake courier API for trying parcel creation and tracking webhooks (docs/SHIPPING.md)
COURIER_SANDBOX=false

# --- AI layer (optional, docs/AI.md) -----------------------------------------------------------------
# none = off (default): every feature works without AI. anthropic = Claude API (paid per use).
AI_PROVIDER=none
# From console.anthropic.com > API keys. Put it in the secrets manager in production, never in git.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=15000
AI_DAILY_TOKEN_BUDGET=500000
AI_USER_HOURLY_LIMIT=30

# Only the Payment Service reads the following. Never give them to ARUMA CORE or a frontend.
PAYMENTS_DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma
PAYMENTS_PUBLIC_URL=http://localhost:3200
CORE_EVENTS_URL=http://localhost:3000/internal/payments/events
# sandbox (local development only) or chargily
ONLINE_PROVIDER=sandbox
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
CHARGILY_AMOUNT_UNIT=major

# --- Backups (scripts/backup.sh) — on the backup machine, not in the API's environment ---------------
# age PUBLIC key: the server can write backups, only the offline private key can read them
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/srv/aruma-backups
RETENTION_DAYS=30
