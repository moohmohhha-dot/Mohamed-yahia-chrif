# PostgreSQL connection used by the API and migrations
DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma
# Separate database used by automated tests (it is wiped on every test run)
TEST_DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma_test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
# Max login/register attempts per IP per minute
AUTH_RATE_LIMIT_MAX=10
# 32 random bytes, base64 — generate with: openssl rand -base64 32
# Encrypts ID numbers, account numbers and documents. Keep it secret and backed up: losing it loses that data.
DATA_ENCRYPTION_KEY=
# Where uploaded documents are stored (encrypted)
STORAGE_DIR=./storage
NODE_ENV=development

# --- Payment Service (apps/payments) and its link with ARUMA CORE --------------------------------
# Generate each secret with: openssl rand -hex 32   (the same value goes to both services)
PAYMENTS_URL=http://localhost:3200
PAYMENTS_SERVICE_TOKEN=
PAYMENTS_EVENTS_SECRET=
STOREFRONT_URL=http://localhost:5174

# Only the Payment Service reads the following. Never give them to ARUMA CORE or a frontend.
PAYMENTS_DATABASE_URL=postgres://aruma:aruma@localhost:5432/aruma
PAYMENTS_PUBLIC_URL=http://localhost:3200
CORE_EVENTS_URL=http://localhost:3000/internal/payments/events
# sandbox (local development only) or chargily
ONLINE_PROVIDER=sandbox
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
CHARGILY_AMOUNT_UNIT=major
