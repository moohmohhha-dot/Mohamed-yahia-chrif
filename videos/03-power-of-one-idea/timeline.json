  "lines": [
    {
      "id": "L01",
      "who": "boy",
      "start": 0.9,
      "end": 4.6,
      "text": "Our garden is dying... but we water it every single day!"
    },
    {
      "id": "L02",
      "who": "boy",
      "start": 5.6,
      "end": 8.6,
      "text": "So where is all the water going?"
    },
    {
      "id": "L03",
      "who": "young_man",
      "start": 12.9,
      "end": 15.0,
      "text": "Wait... hear that dripping?"
    },
    {
      "id": "L04",
      "who": "young_man",
      "start": 15.4,
      "end": 19.4,
      "text": "This old pipe is leaking! The water never reaches the plants."
    },
    {
      "id": "L05",
      "who": "elder",
      "start": 20.4,
      "end": 23.6,
      "text": "Fix the leak first. Then let the sky help you."
    },
    {
      "id": "L06",
      "who": "elder",
      "start": 25.6,
      "end": 29.6,
      "text": "One millimeter of rain on one square meter gives one liter of water."
    },
    {
      "id": "L07",
      "who": "delivery",
      "start": 31.6,
      "end": 34.0,
      "text": "Special delivery! Reusable containers!"
    },
    {
      "id": "L08",
      "who": "boy",
      "start": 34.6,
      "end": 37.0,
      "text": "We can catch the rain from the roof!"
    },
    {
      "id": "L09",
      "who": "young_man",
      "start": 37.4,
      "end": 39.4,
      "text": "Let's build it together!"
    },
    {
      "id": "L10",
      "who": "elder",
      "start": 40.8,
      "end": 44.6,
      "text": "Science plus teamwork. That's how small ideas grow."
    },
    {
      "id": "L11",
      "who": "boy",
      "start": 45.4,
      "end": 48.8,
      "text": "Look! The tanks are filling up!"
    },
    {
      "id": "L12",
      "who": "boy",
      "start": 50.8,
      "end": 54.0,
      "text": "One small idea... saved our whole garden!"
    },
    {
      "id": "L13",
      "who": "elder",
      "start": 55.0,
      "end": 58.8,
      "text": "Think smart. Save water. Change the world."
    }
